# Used by docker-compose.yml. On the server: cp .env.production.example .env
# Generate secrets with: openssl rand -hex 32

# DB (not exposed outside Docker; the API connects to it as host "db")
POSTGRES_USER=pokertrainer
POSTGRES_PASSWORD=change-me
POSTGRES_DB=poker_trainer

# API auth
ACCESS_TOKEN_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=60

# Host ports, bound to 127.0.0.1 for the reverse proxy (Caddy)
# Route /api/* to API_PORT and everything else to MOBILE_WEB_PORT
API_PORT=8000
MOBILE_WEB_PORT=3000
